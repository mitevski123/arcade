import pygame
import random

# --- Constants ---
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
PLAYER_SPEED = 5
ENEMY_SPEED = 2.5

# Walkable floor boundaries
MIN_Y = 350  
MAX_Y = 550  

# Colors
WHITE = (255, 255, 255)
RED = (255, 50, 50)
BLUE = (50, 50, 255)
YELLOW = (255, 255, 0)
BLACK = (0, 0, 0)
GRAY = (80, 80, 80)
SKY_BLUE = (135, 206, 235)
GROUND_GREEN = (34, 139, 34)

# --- Game Manager & Camera ---
class GameManager:
    def __init__(self):
        self.camera_x = 0
        self.world_width = 3200  # A long scrolling level
        self.screen_lock = False
        
        # UI Font setup
        self.font = pygame.font.SysFont('Arial', 50, bold=True)
        self.go_text = self.font.render('GO ➡️', True, RED)
        self.go_flash_timer = 0

        # Define enemy waves: (trigger_camera_x, list_of_spawn_coords_in_world_space)
        self.waves = [
            {
                'trigger': 400, 
                'spawns': [(1000, 400), (1100, 480)], 
                'spawned': False
            },
            {
                'trigger': 1400, 
                'spawns': [(2000, 380), (2100, 480), (2200, 430)], 
                'spawned': False
            }
        ]

    def draw_background(self, screen):
        # Draw sky
        screen.fill(SKY_BLUE)
        
        # Draw scrolling ground
        ground_rect = pygame.Rect(0, MIN_Y - 40, SCREEN_WIDTH, SCREEN_HEIGHT - MIN_Y + 40)
        pygame.draw.rect(screen, GROUND_GREEN, ground_rect)
        
        # Draw simple scrolling trees to give a sense of movement
        for i in range(0, self.world_width, 250):
            tree_pos_x = i - self.camera_x
            # Only draw trees if they are currently visible on screen
            if -100 < tree_pos_x < SCREEN_WIDTH + 100:
                # Trunk
                pygame.draw.rect(screen, (139, 69, 19), [tree_pos_x, MIN_Y - 100, 20, 60]) 
                # Leaves
                pygame.draw.circle(screen, (0, 128, 0), (tree_pos_x + 10, MIN_Y - 120), 40) 

    def draw_hud(self, screen):
        # Flash the "GO!" indicator at the right edge when the path is clear
        if not self.screen_lock:
            self.go_flash_timer = (self.go_flash_timer + 1) % 60
            if self.go_flash_timer < 30:
                screen.blit(self.go_text, (SCREEN_WIDTH - self.go_text.get_width() - 20, 20))

# --- Player Class ---
class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface([40, 80])
        self.image.fill(WHITE)
        self.rect = self.image.get_rect()
        
        # Starting position in World Space
        self.rect.x = 200
        self.rect.y = 400
        
        # Shadow setup
        self.shadow_rect = pygame.Rect(0, 0, 40, 10)
        self.update_shadow()

        # States
        self.is_attacking = False
        self.attack_timer = 0
        self.facing_right = True
        self.is_hit = False
        self.hit_timer = 0

    def update_shadow(self):
        self.shadow_rect.midbottom = self.rect.midbottom

    def take_hit(self, knockback_dir):
        if not self.is_hit:
            self.is_hit = True
            self.hit_timer = 15
            self.rect.x += knockback_dir * 20
            self.image.fill(YELLOW)  # Flash yellow when hurt

    def update(self, game_manager):
        # Handle hit stun
        if self.is_hit:
            self.hit_timer -= 1
            if self.hit_timer <= 0:
                self.is_hit = False
                self.image.fill(WHITE)
            self.update_shadow()
            return

        # Handle attack frames
        if self.is_attacking:
            self.attack_timer -= 1
            if self.attack_timer <= 0:
                self.is_attacking = False
                self.image.fill(WHITE)
        else:
            # Handle standard movement
            keys = pygame.key.get_pressed()
            if keys[pygame.K_LEFT]:
                self.rect.x -= PLAYER_SPEED
                self.facing_right = False
            if keys[pygame.K_RIGHT]:
                self.rect.x += PLAYER_SPEED
                self.facing_right = True
            if keys[pygame.K_UP]:
                self.rect.y -= PLAYER_SPEED
            if keys[pygame.K_DOWN]:
                self.rect.y += PLAYER_SPEED

            # Trigger Attack
            if keys[pygame.K_SPACE]:
                self.is_attacking = True
                self.attack_timer = 10
                self.image.fill(RED)

        # Clamping player inside the walkable world boundaries
        if self.rect.bottom > MAX_Y: self.rect.bottom = MAX_Y
        if self.rect.bottom < MIN_Y: self.rect.bottom = MIN_Y
        
        # Left boundary of the entire world
        if self.rect.left < 0: self.rect.left = 0
        
        # Right boundary of the entire world
        if self.rect.right > game_manager.world_width: self.rect.right = game_manager.world_width

        # Keep player on screen if camera is locked by enemies
        if game_manager.screen_lock:
            if self.rect.left < game_manager.camera_x:
                self.rect.left = game_manager.camera_x
            if self.rect.right > game_manager.camera_x + SCREEN_WIDTH:
                self.rect.right = game_manager.camera_x + SCREEN_WIDTH

        self.update_shadow()

# --- Enemy Class ---
class Enemy(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.image = pygame.Surface([40, 80])
        self.image.fill(BLUE)
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        
        # Shadow setup
        self.shadow_rect = pygame.Rect(0, 0, 40, 10)
        self.update_shadow()

        self.knockback_timer = 0
        self.facing_right = False
        self.is_attacking = False
        self.attack_timer = 0
        self.attack_cooldown = 0
        self.decision_timer = 0
        self.target_offset_y = 0
        self.health = 3  # Takes 3 hits to defeat

    def update_shadow(self):
        self.shadow_rect.midbottom = self.rect.midbottom

    def take_hit(self, knockback_dir):
        if self.knockback_timer == 0:
            self.health -= 1
            if self.health <= 0:
                self.kill()  # Safely delete enemy sprite
                return
            self.image.fill(WHITE)
            self.knockback_timer = 12
            self.is_attacking = False
            self.rect.x += knockback_dir * 25

    def update(self, player_target, game_manager):
        # Reeling from hit
        if self.knockback_timer > 0:
            self.knockback_timer -= 1
            if self.knockback_timer == 0: 
                self.image.fill(BLUE)
            self.update_shadow()
            return
            
        # Executing attack
        if self.is_attacking:
            self.attack_timer -= 1
            if self.attack_timer <= 0:
                self.is_attacking = False
                self.image.fill(BLUE)
            self.update_shadow()
            return

        if self.attack_cooldown > 0:
            self.attack_cooldown -= 1

        # AI Behavior Decisions
        self.decision_timer -= 1
        if self.decision_timer <= 0:
            self.decision_timer = random.randint(15, 30)
            self.target_offset_y = random.randint(-15, 15)

        target_x = player_target.rect.centerx
        target_y = player_target.rect.bottom + self.target_offset_y
        
        dx = target_x - self.rect.centerx
        dy = target_y - self.rect.bottom
        self.facing_right = dx > 0

        # Trigger punch if aligned with player
        if abs(dx) < 65 and abs(dy) < 15 and self.attack_cooldown == 0 and not player_target.is_hit:
            self.is_attacking = True
            self.attack_timer = 15
            self.attack_cooldown = 45
            self.image.fill(RED)  # Flash red before punching
            self.update_shadow()
            return

        # Walk to player (Y/Z depth priority)
        if abs(dy) > 10:
            self.rect.y += ENEMY_SPEED if dy > 0 else -ENEMY_SPEED
        elif abs(dx) > 15:
            self.rect.x += ENEMY_SPEED if dx > 0 else -ENEMY_SPEED
            
        # World boundaries clamp
        if self.rect.bottom > MAX_Y: self.rect.bottom = MAX_Y
        if self.rect.bottom < MIN_Y: self.rect.bottom = MIN_Y

        self.update_shadow()

# --- Main Game Setup ---
def main():
    pygame.init()
    screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
    pygame.display.set_caption("Stage Progression Prototype")
    
    game_manager = GameManager()
    player = Player()
    
    # Sprite Groups
    all_sprites = pygame.sprite.Group()
    enemies = pygame.sprite.Group()
    all_sprites.add(player)

    clock = pygame.time.Clock()
    running = True

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        # --- Wave Management ---
        game_manager.screen_lock = len(enemies) > 0
        
        # Check triggers and spawn wave
        for wave in game_manager.waves:
            if not wave['spawned'] and game_manager.camera_x >= wave['trigger']:
                wave['spawned'] = True
                for pos in wave['spawns']:
                    new_enemy = Enemy(pos[0], pos[1])
                    enemies.add(new_enemy)
                    all_sprites.add(new_enemy)
        
        # --- Update ---
        player.update(game_manager)
        enemies.update(player, game_manager)
        
        # Smooth camera following (runs only when screen is not locked)
        if not game_manager.screen_lock:
            target_camera_x = player.rect.centerx - SCREEN_WIDTH // 2
            game_manager.camera_x = max(0, min(target_camera_x, game_manager.world_width - SCREEN_WIDTH))

        # --- Combat System ---
        # 1. Player punching Enemy
        if player.is_attacking and player.attack_timer == 9:
            for enemy in enemies:
                z_diff = abs(player.shadow_rect.centery - enemy.shadow_rect.centery)
                x_diff = enemy.rect.centerx - player.rect.centerx
                
                # Check directional reach
                in_range_x = (player.facing_right and 0 < x_diff < 70) or \
                             (not player.facing_right and -70 < x_diff < 0)

                if z_diff < 20 and in_range_x:
                    knock_dir = 1 if player.facing_right else -1
                    enemy.take_hit(knock_dir)
        
        # 2. Enemies punching Player
        for enemy in enemies:
            if enemy.is_attacking and enemy.attack_timer == 5:
                z_diff = abs(player.shadow_rect.centery - enemy.shadow_rect.centery)
                x_diff = player.rect.centerx - enemy.rect.centerx
                
                # Check directional reach
                in_range_x = (enemy.facing_right and 0 < x_diff < 70) or \
                             (not enemy.facing_right and -70 < x_diff < 0)

                if z_diff < 20 and in_range_x:
                    knock_dir = 1 if enemy.facing_right else -1
                    player.take_hit(knock_dir)

        # --- Draw Stage (Using Camera Offset) ---
        game_manager.draw_background(screen)
        
        # Draw shadows first (sorted) so they are always under feet
        sorted_sprites = sorted(all_sprites.sprites(), key=lambda s: s.rect.bottom)
        for sprite in sorted_sprites:
            shadow_x = sprite.shadow_rect.x - game_manager.camera_x
            pygame.draw.ellipse(screen, GRAY, (shadow_x, sprite.shadow_rect.y, sprite.shadow_rect.width, sprite.shadow_rect.height))
            
        # Draw main character bodies (depth sorted) on top
        for sprite in sorted_sprites:
            screen_x = sprite.rect.x - game_manager.camera_x
            screen.blit(sprite.image, (screen_x, sprite.rect.y))

        # Draw text & HUD overlays on top of world
        game_manager.draw_hud(screen)
        
        pygame.display.flip()
        clock.tick(60)

    pygame.quit()

if __name__ == "__main__":
    main()
