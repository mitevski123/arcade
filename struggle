import pygame
import os
import sys

# --- Constants ---
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
GROUND_Y = 450 # A simple line for the ground

# Player Physics
PLAYER_ACCEL = 0.8
PLAYER_FRICTION = 0.85 # A little less friction to feel the slide
PLAYER_MAX_SPEED = 6.0

# --- Sprite Sheet Dimensions ---
SPRITE_WIDTH = 77
SPRITE_HEIGHT = 122

# --- Colors ---
SKY_BLUE = (135, 206, 235)
GROUND_GREEN = (34, 139, 34)
GRAY = (80, 80, 80)

# --- Sprite Sheet Class ---
class SpriteSheet:
    def __init__(self, filename):
        try:
            self.sheet = pygame.image.load(filename).convert_alpha()
        except pygame.error as e:
            print(f"Unable to load spritesheet image: {filename}")
            raise SystemExit(e)

    def get_animation_frames(self, num_frames, width, height):
        frames = []
        for i in range(num_frames):
            image = pygame.Surface((width, height), pygame.SRCALPHA)
            image.blit(self.sheet, (0, 0), (i * width, 0, width, height))
            frames.append(image)
        return frames

# --- Player Class ---
class Player(pygame.sprite.Sprite):
    def __init__(self, sprites):
        super().__init__()
        self.sprites = sprites
        self.image = self.sprites['idle'][0]
        self.rect = self.image.get_rect(midbottom=(SCREEN_WIDTH // 2, GROUND_Y))
        
        # Physics and position variables
        self.pos_x, self.pos_y = float(self.rect.x), float(self.rect.y)
        self.vel_x = 0.0
        self.facing_right = True
        
        # Animation variables
        self.anim_frame = 0
        self.anim_timer = 0
        self.is_moving = False

    def update(self):
        # --- INPUT ---
        keys = pygame.key.get_pressed()
        move_input_x = 0
        if keys[pygame.K_LEFT]:
            move_input_x = -1
            self.facing_right = False
        if keys[pygame.K_RIGHT]:
            move_input_x = 1
            self.facing_right = True

        # --- PHYSICS ---
        if move_input_x != 0:
            self.vel_x = max(-PLAYER_MAX_SPEED, min(self.vel_x + move_input_x * PLAYER_ACCEL, PLAYER_MAX_SPEED))
        else:
            self.vel_x *= PLAYER_FRICTION

        # Apply velocity to the floating-point position
        self.pos_x += self.vel_x
        self.rect.x = int(self.pos_x) # Update the integer rect for drawing

        # --- ANIMATION ---
        self.is_moving = abs(self.vel_x) > 0.5
        if self.is_moving:
            self.anim_timer += 1
            if self.anim_timer >= 6: # Slower animation speed
                self.anim_timer = 0
                self.anim_frame = (self.anim_frame + 1) % len(self.sprites['walk'])
            current_image = self.sprites['walk'][self.anim_frame]
        else:
            self.anim_frame = 0
            current_image = self.sprites['idle'][0]
            
        self.image = pygame.transform.flip(current_image, not self.facing_right, False)

        # --- BOUNDARIES ---
        if self.rect.left < 0: self.rect.left, self.pos_x = 0, 0.0
        if self.rect.right > SCREEN_WIDTH: self.rect.right, self.pos_x = SCREEN_WIDTH, float(SCREEN_WIDTH - self.rect.width)


# --- Main Program ---
def main():
    pygame.init()
    screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
    pygame.display.set_caption("Animation and Movement Test")

    try:
        script_directory = os.path.dirname(os.path.abspath(__file__))
        assets_path = os.path.join(script_directory, 'assets')
        player_sheet = SpriteSheet(os.path.join(assets_path, 'player_sheet.png'))
        
        walk_frames = player_sheet.get_animation_frames(num_frames=8, width=SHEET_FRAME_WIDTH, height=SHEET_FRAME_HEIGHT)
        player_sprites = {
            'idle': [walk_frames[0]],
            'walk': walk_frames
        }
    except pygame.error as e:
        print(f"❌ Error loading 'player_sheet.png': {e}\nCheck your 'assets' folder."); pygame.quit(); sys.exit()

    player = Player(player_sprites)
    all_sprites = pygame.sprite.Group(player)
    clock = pygame.time.Clock()
    running = True

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT: running = False

        player.update()

        # --- Draw ---
        screen.fill(SKY_BLUE)
        pygame.draw.line(screen, GROUND_GREEN, (0, GROUND_Y), (SCREEN_WIDTH, GROUND_Y), 5)
        
        # We don't need a camera for this test
        all_sprites.draw(screen)
        
        pygame.display.flip()
        clock.tick(60)
    pygame.quit()

if __name__ == "__main__":
    main()

