import pygame
import os
import sys

# --- Constants ---
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
MIN_Y, MAX_Y = 380, 560
PLAYER_ACCEL, PLAYER_FRICTION, PLAYER_MAX_SPEED = 0.8, 0.82, 6.0
SKY_BLUE, GROUND_GREEN, GRAY = (135, 206, 235), (34, 139, 34), (80, 80, 80)

# --- Player Class ---
class Player(pygame.sprite.Sprite):
    def __init__(self, sprites):
        super().__init__()
        self.sprites = sprites
        self.image = self.sprites['idle'][0]
        self.rect = self.image.get_rect(midbottom=(SCREEN_WIDTH // 3, MAX_Y))
        self.shadow_rect = pygame.Rect(0, 0, self.rect.width * 0.6, 10)
        self.pos_x, self.pos_y = float(self.rect.x), float(self.rect.y)
        self.vel_x, self.vel_y = 0.0, 0.0
        self.facing_right = True
        self.anim_frame, self.anim_timer = 0, 0
        self.update_shadow()

    def update_shadow(self):
        self.shadow_rect.midbottom = self.rect.midbottom

    def update(self):
        keys = pygame.key.get_pressed()
        move_input_x, move_input_y = 0, 0
        
        if keys[pygame.K_LEFT]: move_input_x = -1; self.facing_right = False
        if keys[pygame.K_RIGHT]: move_input_x = 1; self.facing_right = True
        if keys[pygame.K_UP]: move_input_y = -1
        if keys[pygame.K_DOWN]: move_input_y = 1
        
        if move_input_x != 0: self.vel_x = max(-PLAYER_MAX_SPEED, min(self.vel_x + move_input_x * PLAYER_ACCEL, PLAYER_MAX_SPEED))
        else: self.vel_x *= PLAYER_FRICTION
        if move_input_y != 0: self.vel_y = max(-PLAYER_MAX_SPEED, min(self.vel_y + move_input_y * PLAYER_ACCEL, PLAYER_MAX_SPEED))
        else: self.vel_y *= PLAYER_FRICTION
            
        self.pos_x += self.vel_x; self.pos_y += self.vel_y
        self.rect.x, self.rect.y = int(self.pos_x), int(self.pos_y)

        is_moving = abs(self.vel_x) > 0.5 or abs(self.vel_y) > 0.5
        if is_moving:
            self.anim_timer += 1
            if self.anim_timer >= 5:
                self.anim_timer = 0
                self.anim_frame = (self.anim_frame + 1) % len(self.sprites['walk'])
            current_image = self.sprites['walk'][self.anim_frame]
        else:
            self.anim_frame = 0; current_image = self.sprites['idle'][0]
            
        self.image = pygame.transform.flip(current_image, not self.facing_right, False)
        
        if self.rect.bottom > MAX_Y: self.rect.bottom, self.pos_y = MAX_Y, float(self.rect.y)
        if self.rect.bottom < MIN_Y: self.rect.bottom, self.pos_y = MIN_Y, float(self.rect.y)
        if self.rect.left < 0: self.rect.left, self.pos_x = 0, float(self.rect.x)
        if self.rect.right > 3200: self.rect.right, self.pos_x = 3200, float(self.rect.x)
        self.update_shadow()

# --- Main Program ---
def main():
    pygame.init()
    screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
    pygame.display.set_caption("Player Walk and Scroll Test")

    try:
        script_directory = os.path.dirname(os.path.abspath(__file__))
        assets_path = os.path.join(script_directory, 'assets')
        
        # Load the 8 individual frames
        walk_frames = []
        for i in range(1, 9):
            img = pygame.image.load(os.path.join(assets_path, f'player_walk_{i}.png')).convert_alpha()
            walk_frames.append(pygame.transform.scale(img, (80, 110)))

        player_sprites = {'idle': [walk_frames[0]], 'walk': walk_frames}

    except pygame.error as e:
        print(f"❌ Error loading assets: {e}\nEnsure player_walk_1.png through player_walk_8.png are in your 'assets' folder."); pygame.quit(); sys.exit()

    player = Player(player_sprites)
    all_sprites = pygame.sprite.Group(player)
    camera_x = 0; clock = pygame.time.Clock(); running = True

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT: running = False

        player.update()
        target_camera_x = player.pos_x - SCREEN_WIDTH // 3
        camera_x = max(0, min(target_camera_x, 3200 - SCREEN_WIDTH))

        screen.fill(SKY_BLUE)
        pygame.draw.rect(screen, GROUND_GREEN, [0, MIN_Y - 40, SCREEN_WIDTH, SCREEN_HEIGHT])
        for i in range(0, 3200, 250):
            tree_pos_x = i - camera_x
            if -100 < tree_pos_x < SCREEN_WIDTH + 100:
                pygame.draw.rect(screen, (139, 69, 19), [tree_pos_x, MIN_Y - 100, 20, 60])
                pygame.draw.circle(screen, (0, 128, 0), (tree_pos_x + 10, MIN_Y - 120), 40)
        
        for sprite in all_sprites:
            screen_x, shadow_x = sprite.rect.x - camera_x, sprite.shadow_rect.x - camera_x
            pygame.draw.ellipse(screen, GRAY, (shadow_x, sprite.shadow_rect.y, sprite.shadow_rect.width, sprite.shadow_rect.height))
            screen.blit(sprite.image, (screen_x, sprite.rect.y))
        
        pygame.display.flip()
        clock.tick(60)
    pygame.quit()

if __name__ == "__main__":
    main()

